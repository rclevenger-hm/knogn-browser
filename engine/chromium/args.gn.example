# Knogn Chromium primary backend.
#
# This is an open-source Chromium build with Knogn product overlays. It is not a
# Google Chrome branded build and intentionally does not embed restricted browser
# OAuth credentials or official Google API keys.

is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

is_chrome_branded = false
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Keep Widevine key-system support compiled in so an approved separately supplied
# CDM can be discovered later. This does not bundle or redistribute Widevine.
enable_widevine = true

# Public baseline remains open-codec-only until codec redistribution rights are
# resolved. Local media-parity experiments switch these two values to true/Chrome.
proprietary_codecs = false
ffmpeg_branding = "Chromium"

# Compatibility first. Avoid removing standards or browser surfaces merely to
# reduce binary size.
enable_nacl = false
rtc_use_pipewire = true
